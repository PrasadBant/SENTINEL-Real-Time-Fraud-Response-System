# Read by `docker compose up` for variable substitution in
# docker-compose.yml (the api service's environment). Copy to .env at
# the repo root and fill in real values — this is a DIFFERENT file from
# backend/.env.example, which is for running `python main.py` directly
# on the host without compose.
#
#   cp .env.example .env

# Required — docker-compose refuses to start the api service without
# these (see app/core/users.py's fail-closed check).
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# Optional — see backend/.env.example for what each of these does.
ADMIN_USERNAME=admin
VIEWER_USERNAME=viewer
SECRET_KEY=
SIMULATOR_API_KEY=sentinel-dev-simulator-key
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
HF_API_KEY=
