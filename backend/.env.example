# SQLAlchemy database URL. Defaults to local SQLite if unset.
# For the Postgres service in docker-compose.yml:
#   postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=

# Redis URL — velocity/account cache, WebSocket pub/sub fanout, and EC-03
# withdrawal-timer scheduling (see app/core/redis_client.py). Defaults to
# a local Redis if unset. For the Redis service in docker-compose.yml:
#   redis://localhost:6379/0
REDIS_URL=

# Secret used for signing auth tokens (JWT). REQUIRED — the app refuses
# to start without it (Phase 2: an ephemeral per-process fallback would
# silently break auth the moment more than one API replica exists, since
# each would sign/verify with a different random key). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of frontend origins allowed to call this API
# (CORS). Do NOT use "*" — it is incompatible with allow_credentials=True.
CORS_ORIGINS=http://localhost:5173

# Bootstrap login accounts (see app/core/users.py / repository.py's
# seed_default_users()). Usernames default to admin/viewer if unset, but
# ADMIN_PASSWORD/VIEWER_PASSWORD are REQUIRED — the app refuses to start
# without them (no more admin123/viewer123 fallback). These are only
# consulted on first boot to create the DB-backed user rows (Phase 2) —
# changing them later does NOT change an already-created account's
# password; the database row is the durable source of truth from then on.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=

# How long a login token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Brute-force login lockout (Phase 2 — app/services/login_guard.py,
# Redis-backed). After this many failed attempts for one username within
# the lockout window, further attempts (even with the correct password)
# are rejected with 429 until the window expires.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Static shared-secret header (X-API-Key) required on POST /transaction.
# The simulator is a standalone script with no login, so it authenticates
# with this key instead of a user JWT. Must match SENTINEL_API_KEY in
# backend/simulator's environment (or its default) for the simulator to work.
SIMULATOR_API_KEY=sentinel-dev-simulator-key

# --- AI Copilot (app/services/ai_providers/) ---
# Which LLM backend powers the copilot. One of: anthropic, huggingface,
# mock, openai, gemini, ollama. openai/gemini/ollama are declared but not
# implemented yet (selecting one raises on startup). If unset, the app
# auto-detects: ANTHROPIC_API_KEY present -> anthropic, else HF_API_KEY
# present -> huggingface, else mock (canned offline responses, no key
# needed — this is what runs out of the box).
AI_PROVIDER=

# API key for the Anthropic (Claude) provider. Required if AI_PROVIDER=
# anthropic, or picked up automatically by auto-detection above.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the copilot. Defaults to
# claude-opus-5 if unset.
ANTHROPIC_MODEL=

# Optional: Hugging Face Inference API key for the AI Copilot.
# If unset (and no ANTHROPIC_API_KEY / AI_PROVIDER), the copilot falls
# back to a canned offline response mode (MockProvider).
HF_API_KEY=
