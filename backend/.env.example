# SQLAlchemy database URL. Defaults to local SQLite if unset.
# For Postgres in production: postgresql://user:password@host:5432/sentinel
DATABASE_URL=

# Secret used for signing auth tokens (JWT). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at process startup — fine for a
# single local dev session, but existing tokens won't survive a restart.
SECRET_KEY=

# Comma-separated list of frontend origins allowed to call this API
# (CORS). Do NOT use "*" — it is incompatible with allow_credentials=True.
CORS_ORIGINS=http://localhost:5173

# Demo login accounts (see app/core/users.py). Defaults match what the
# frontend used to hardcode client-side; override for any deployment
# beyond local demo use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# How long a login token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Static shared-secret header (X-API-Key) required on POST /transaction.
# The simulator is a standalone script with no login, so it authenticates
# with this key instead of a user JWT. Must match SENTINEL_API_KEY in
# backend/simulator's environment (or its default) for the simulator to work.
SIMULATOR_API_KEY=sentinel-dev-simulator-key

# --- AI Copilot (app/services/ai_providers/) ---
# Which LLM backend powers the copilot. One of: anthropic, huggingface,
# mock, openai, gemini, ollama. openai/gemini/ollama are declared but not
# implemented yet (selecting one raises on startup). If unset, the app
# auto-detects: ANTHROPIC_API_KEY present -> anthropic, else HF_API_KEY
# present -> huggingface, else mock (canned offline responses, no key
# needed — this is what runs out of the box).
AI_PROVIDER=

# API key for the Anthropic (Claude) provider. Required if AI_PROVIDER=
# anthropic, or picked up automatically by auto-detection above.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the copilot. Defaults to
# claude-opus-5 if unset.
ANTHROPIC_MODEL=

# Optional: Hugging Face Inference API key for the AI Copilot.
# If unset (and no ANTHROPIC_API_KEY / AI_PROVIDER), the copilot falls
# back to a canned offline response mode (MockProvider).
HF_API_KEY=
